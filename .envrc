# direnv config (auto-loaded on cd if direnv is installed; otherwise: `source .envrc`).
#
# Defaults assume you've created a venv at .venv/ in this repo and want outputs
# written to ./data. Override by exporting these BEFORE sourcing:
#   PYTHON=/some/other/python source .envrc
#   PHASE_H_DATA_ROOT=/some/other/data source .envrc

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" 2>/dev/null && pwd)"
export PYTHON="${PYTHON:-$REPO_DIR/.venv/bin/python}"
export PHASE_H_DATA_ROOT="${PHASE_H_DATA_ROOT:-$REPO_DIR/data}"
