# direnv config (auto-loaded when cd'ing into this dir, if direnv is installed).
# Without direnv, you can use it manually: `source .envrc`.
#
# Defaults point at the parent project's venv and pre-computed activations on
# lisplab. Override in your shell before sourcing if running elsewhere:
#   PYTHON=/some/other/python source .envrc
#   PHASE_H_DATA_ROOT=/some/other/data source .envrc

export PYTHON="${PYTHON:-/jumbo/lisp/fl1/assistant-axis-abliteration/.venv/bin/python}"
export PHASE_H_DATA_ROOT="${PHASE_H_DATA_ROOT:-/jumbo/lisp/fl1/assistant-axis-abliteration/results}"
